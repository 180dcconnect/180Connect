# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# .env.example carries no secrets and is the documented list of what the app
# needs, so it is committed on purpose.
!.env.example

# local database dump/restore testing (F225) — real backups contain real
# personal data and must never be committed, even for a "quick test"
/dumps/

# Data Model spreadsheet — the schema source of truth (SOP §7), but binary and
# large. It is never committed: the readable projection under docs/data-model/ is,
# generated by `npm run export:data-model`. If a copy is dropped in the repo, ignore it.
*.xlsx

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
