{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    // `npm test` runs *.test.ts through node --test, which strips types rather
    // than bundling, so test files must import with an explicit .ts extension.
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      // The vendored CherryBlossomQRCode component imports React Native
      // runtime packages. At bundle time next.config.ts aliases them to web
      // equivalents (react-native-web + the shims in src/lib/web-shims/);
      // these paths make the TypeScript compiler resolve them the same way.
      "react-native-reanimated": ["./src/lib/web-shims/react-native-reanimated.ts"],
      "react-native-keyboard-controller": ["./src/lib/web-shims/react-native-keyboard-controller.ts"],
      "react-native-pulsar": ["./src/lib/web-shims/react-native-pulsar.ts"],
      "react-native-webgpu": ["./src/lib/web-shims/react-native-webgpu.tsx"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.mts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
