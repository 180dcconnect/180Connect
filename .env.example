# 180Connect environment variables
#
# Copy this file to `.env.local` and fill in the values:
#
#     cp .env.example .env.local
#
# `.env.local` is gitignored and must never be committed. This file is the
# documented list of what the app needs — keep it in sync with the schema in
# `src/lib/env.ts`. See `docs/environment-variables.md` for details.
#
# Ask the project admin for the real values.


# --- Required ---------------------------------------------------------------
# The server refuses to start without these.

# Absolute base URL this deployment is served from.
# Local development: http://localhost:3000
# Production: the real domain, no trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase project URL for this environment.
# Supabase dashboard -> Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase publishable key. Safe in the browser; access is still constrained by
# row-level security. Read by `src/lib/supabase/server.ts`.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Cloudflare Turnstile site key for the login CAPTCHA (F003). Public by design:
# it only identifies the widget, and validating a token needs the paired secret
# that lives in Supabase (Authentication -> Attack Protection). The value below
# is Cloudflare's official always-pass test key — correct for local development
# and CI. Staging and production use the real key from the Cloudflare dashboard.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA


# --- Optional ---------------------------------------------------------------
# Consumed today, but each has a working default or an alternative.

# Legacy name for the publishable key (F223). Read as a fallback by
# `src/lib/supabase/server.ts`; prefer NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
# above. Set one or the other — the server will not start with neither.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Email domain users must sign in from. Server-only — do not prefix this value
# with NEXT_PUBLIC_. Read by `src/app/login/actions.ts`, which defaults to
# 180dc.org when unset.
AUTH_ALLOWED_EMAIL_DOMAIN=180dc.org

# SECRET. Cloudflare Turnstile secret key, the server half of the pair above
# (F003). The deployed app never reads it — Supabase holds it and validates the
# token — but `supabase/config.toml` reads it when running the local Supabase
# stack. Use Cloudflare's documented always-pass test secret locally:
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
TURNSTILE_SECRET_KEY=


# --- Not yet required -------------------------------------------------------
# Declared so the list is complete, but nothing consumes them yet. Each becomes
# required in `src/lib/env.ts` when the feature that uses it is merged.

# SECRET. Supabase service-role key (F223).
# Bypasses row-level security. Server-side only — never add a NEXT_PUBLIC_
# prefix to this, and never read it from a client component.
SUPABASE_SERVICE_ROLE_KEY=

# SECRET. Key used to sign the inactivity record behind session expiry (F007).
# Server-side only — never add a NEXT_PUBLIC_ prefix. Leave unset locally and
# sessions still expire after 30 idle minutes; set it in staging and production
# so the record cannot be forged by a replayed session. Generate with
# `openssl rand -base64 32`. Changing it signs every open session out once.
SESSION_ACTIVITY_SECRET=

# SECRET. Postgres connection string for the database `npm run seed` (and
# `npm run seed:clear`) writes to (F233). Only the seed scripts read this — the
# app never does.
# Use the SESSION POOLER string: dashboard -> Connect -> Session pooler. It is
# IPv4 (works everywhere) and behaves like a direct connection. The direct
# (db.<ref>.supabase.co) string is IPv6-only and will fail on most machines.
#   Session pooler: postgresql://postgres.<ref>:<pw>@aws-1-<region>.pooler.supabase.com:5432/postgres
#   Local stack:    postgresql://postgres:postgres@127.0.0.1:54322/postgres
# The scripts refuse to run if this points at the production project.
SUPABASE_DB_URL=

# SECRET. Shared secret checked by the scheduled-send route handler before it
# does any work, so the endpoint cannot be triggered by anyone who finds the
# URL. See Q-02 in docs/open-questions.md.
CRON_SECRET=

# Sentry DSN — where captured application errors are sent (F226).
# Public by design (a DSN only permits writing events), so it carries the
# NEXT_PUBLIC_ prefix and is safe in the browser bundle. Sentry dashboard ->
# Project Settings -> Client Keys (DSN). Leave unset to log errors to the
# platform console instead of Sentry.
NEXT_PUBLIC_SENTRY_DSN=

# Environment tag applied to captured errors: "staging" or "production" (F226).
# Optional — falls back to Vercel's VERCEL_ENV when unset, so staging (preview)
# and production are distinguished automatically.
SENTRY_ENVIRONMENT=
